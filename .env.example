# ATLAS backend configuration.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------- required
ATLAS_ENVIRONMENT=dev                    # dev | prod
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:CHANGE_ME@127.0.0.1:5432/atlas
ATLAS_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

# Ed25519 private key (base64url, 32 bytes) that signs commands sent to devices.
# Each device pins the matching public key when it pairs, so CHANGING THIS FORCES
# EVERY DEVICE TO PAIR AGAIN. Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
ATLAS_SERVER_SIGNING_KEY=CHANGE_ME_BASE64URL_32_BYTES

# Authorises the very first device pairing, when no trusted device exists yet.
# Remove this line once the Windows agent is paired — with it unset, enrolment
# can only be authorised from an already paired device.
ATLAS_BOOTSTRAP_TOKEN=CHANGE_ME

# ---------------------------------------------------------------- owner
# Used once, to create the owner record during the first bootstrap pairing.
ATLAS_OWNER_DISPLAY_NAME=Owner
ATLAS_OWNER_LANGUAGE=ru
ATLAS_OWNER_TIMEZONE=Asia/Almaty

# ---------------------------------------------------------------- optional
ATLAS_LOG_LEVEL=INFO
ATLAS_DATABASE_ECHO=false                # must stay false in prod
ATLAS_DATABASE_USE_NULL_POOL=false       # true behind pgbouncer
ATLAS_ACCESS_TOKEN_TTL_S=900
ATLAS_CHALLENGE_TTL_S=120
ATLAS_PAIRING_CODE_TTL_S=300
ATLAS_CLOCK_SKEW_TOLERANCE_S=60
ATLAS_HEARTBEAT_INTERVAL_S=30
ATLAS_HEARTBEAT_GRACE_PERIODS=2
ATLAS_HELLO_TIMEOUT_S=10
ATLAS_PAIRING_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------- deployment
# Read by infra/docker-compose.yml, not by the application.
ATLAS_DOMAIN=atlas.example.com
POSTGRES_USER=atlas
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=atlas

# ---------------------------------------------------------------- AI (M3)
# Backend only. Never sent to the Windows agent or the phone, never logged,
# never returned by an endpoint. Without it the assistant endpoint reports that
# no model is configured, rather than pretending to work.
# ATLAS_GEMINI_API_KEY=
# An alias by default, so it cannot go stale. Pin a concrete id (e.g.
# gemini-3.7-flash) if you need reproducible behaviour; appearing in the model
# list is not proof a model still serves generateContent.
ATLAS_GEMINI_MODEL=gemini-flash-latest
# Tried when the first one is overloaded — measured: flash-latest answered 503
# "experiencing high demand" for minutes, taking every scenario down at once.
# Empty disables the fallback.
ATLAS_GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
ATLAS_AI_REQUEST_TIMEOUT_S=45
ATLAS_AI_TURN_TIMEOUT_S=90
# Runaway-loop guards: actions per message, and round trips to the model.
ATLAS_AI_MAX_TOOL_CALLS_PER_TURN=5
ATLAS_AI_MAX_ITERATIONS=3
# Hard daily stop, resets at midnight UTC.
ATLAS_AI_DAILY_TOKEN_BUDGET=2000000

# Directories file tools may touch, as the agent sees them. Empty means no file
# tool can run — the correct default for an unconfigured deployment.
# ATLAS_ALLOWED_FILE_ROOTS=["C:\\Users\\you\\Desktop","C:\\Users\\you\\Documents"]

# ------------------------------------------------------------------ tracker
# The owner's Life OS, reached over HTTP. Backend only: it is a credential with
# write access to their data and has no business on a laptop or a phone. Absent
# either of these, the tracker is off and its tools are not offered.
# ATLAS_SUNNY_BASE_URL=https://your-tracker.vercel.app
# ATLAS_SUNNY_TOKEN=

# ---------------------------------------------------------------------- web
# Looking things up, so the model stops answering "what is the latest X" from
# training data. Free and keyless; off only if this backend should not reach out.
ATLAS_WEB_TOOLS_ENABLED=true

# -------------------------------------------------------------- speaking first
# Reminders, the morning briefing, the evening summary, a word after too long at
# the desk. The timezone is load-bearing: everything is decided in local time.
ATLAS_PROACTIVE_ENABLED=true
ATLAS_OWNER_TIMEZONE=Asia/Almaty
ATLAS_BRIEFING_HOUR=8
ATLAS_BRIEFING_UNTIL_HOUR=12
ATLAS_EVENING_SUMMARY_HOUR=21
ATLAS_EVENING_SUMMARY_UNTIL_HOUR=23
ATLAS_LONG_SESSION_MINUTES=90
# Outside these hours a notification is shown but not spoken.
ATLAS_QUIET_FROM_HOUR=23
ATLAS_QUIET_UNTIL_HOUR=7

# The day written down as a note in the tracker. Needs a tracker to write to.
ATLAS_DAILY_REPORT_ENABLED=true
ATLAS_DAILY_REPORT_HOUR=22

# ------------------------------------------------------------------- prayer
# Computed on this machine, never fetched: an API would carry your coordinates
# and the fact that you pray to a third party, daily, for a page of
# trigonometry. **Both coordinates are required** and neither is guessed — a
# timezone narrows a location to a few hundred kilometres, which moves Maghrib
# by twenty minutes. Almaty is 43.238 / 76.889.
#
# Check one day against your own mosque before trusting it: the methods below
# disagree by twenty minutes or more, and the two Asr schools by about an hour.
# ATLAS_PRAYER_LATITUDE=43.238
# ATLAS_PRAYER_LONGITUDE=76.889
# mwl | isna | egypt | makkah | karachi | tehran | dubai | qatar | kuwait | singapore
ATLAS_PRAYER_METHOD=mwl
# standard | hanafi
ATLAS_PRAYER_ASR=standard
ATLAS_PRAYER_REMINDER_MINUTES=10
# Your mosque's own timetable, as JSON, if you would rather not rely on the
# calculation. Read once at startup; it wins for every day it covers and gives
# way to the calculation for days it does not. Format: docs/PRAYER-SCHEDULE.md.
# ATLAS_PRAYER_TIMETABLE_PATH=

# -------------------------------------------------------------- personality
# How replies are worded, after everything about what they say is decided. It
# can add at most a short address and can never change a fact.
ATLAS_PERSONALITY_ENABLED=true
# professional | jarvis | personal | custom
ATLAS_PERSONALITY_MODE=jarvis
# auto | none | sir
ATLAS_PERSONALITY_ADDRESS=auto

# ---------------------------------------------------------------- later phases
# Not read by any code yet; listed so there is one place for them to land.
# ATLAS_TTS_PROVIDER=              # M4
# ATLAS_TTS_API_KEY=               # M4
# ATLAS_STT_PROVIDER=              # M4
