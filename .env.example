# ATLAS backend configuration.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------- required
ATLAS_ENVIRONMENT=dev                    # dev | prod
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:CHANGE_ME@127.0.0.1:5432/atlas
ATLAS_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

# Ed25519 private key (base64url, 32 bytes) that signs commands sent to devices.
# Each device pins the matching public key when it pairs, so CHANGING THIS FORCES
# EVERY DEVICE TO PAIR AGAIN. Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
ATLAS_SERVER_SIGNING_KEY=CHANGE_ME_BASE64URL_32_BYTES

# Authorises the very first device pairing, when no trusted device exists yet.
# Remove this line once the Windows agent is paired — with it unset, enrolment
# can only be authorised from an already paired device.
ATLAS_BOOTSTRAP_TOKEN=CHANGE_ME

# ---------------------------------------------------------------- owner
# Used once, to create the owner record during the first bootstrap pairing.
ATLAS_OWNER_DISPLAY_NAME=Owner
ATLAS_OWNER_LANGUAGE=ru
ATLAS_OWNER_TIMEZONE=Asia/Almaty

# ---------------------------------------------------------------- optional
ATLAS_LOG_LEVEL=INFO
ATLAS_DATABASE_ECHO=false                # must stay false in prod
ATLAS_DATABASE_USE_NULL_POOL=false       # true behind pgbouncer
ATLAS_ACCESS_TOKEN_TTL_S=900
ATLAS_CHALLENGE_TTL_S=120
ATLAS_PAIRING_CODE_TTL_S=300
ATLAS_CLOCK_SKEW_TOLERANCE_S=60
ATLAS_HEARTBEAT_INTERVAL_S=30
ATLAS_HEARTBEAT_GRACE_PERIODS=2
ATLAS_HELLO_TIMEOUT_S=10
ATLAS_PAIRING_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------- deployment
# Read by infra/docker-compose.yml, not by the application.
ATLAS_DOMAIN=atlas.example.com
POSTGRES_USER=atlas
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=atlas

# ---------------------------------------------------------------- later phases
# Not read by any code yet; listed so there is one place for them to land.
# ATLAS_GEMINI_API_KEY=            # M3
# ATLAS_TTS_PROVIDER=              # M4
# ATLAS_TTS_API_KEY=               # M4
# ATLAS_STT_PROVIDER=              # M4
# ATLAS_TRACKER_BASE_URL=          # M7
# ATLAS_TRACKER_SIGNING_KEY_PATH=  # M7
